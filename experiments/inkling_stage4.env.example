# Example STAGE4_ENV for experiments/inkling_stage4.sh (the driver sources it after its own
# functions, so it may redefine any of them):
#
#   STAGE4_ENV=$PWD/experiments/inkling_stage4.env.example bash experiments/inkling_stage4.sh check
# The driver never takes a GPU or a lease. `gpu_run LABEL python-args...` must run the python
# arguments on the devices of a lease the caller holds; the default one refuses unless
# HIP_VISIBLE_DEVICES is set. On the build box it goes through a guard that checks the lease
# file, the quiet markers, the PCI buses, GPU page faults and the temperature, and a wrapper
# that sets PYTHONPATH (the tree and the fork's transformers), HF_HUB_OFFLINE and the ROCm
# libraries; `cpu_run` is the same wrapper with no GPU visible. A step runs for hours, so the
# guard holds the box's boot lock for the first GUARD_BOOT_SECONDS only (its default, for the
# short smoke runs, is the whole command).
W=${W:-$HOME/w4a8_runs/inkling-hi2}
export PYPATH_EXTRA=${PYPATH_EXTRA:-$HOME/w4a8_runs/pydeps/tfm-main} # the fork's transformers
cpu_run() { OMP_NUM_THREADS=${OMP_NUM_THREADS:-8} "$W/cpu.sh" "$@"; }
gpu_run() {
    local label=$1
    shift
    GUARD_BOOT_SECONDS=${STAGE4_BOOT_SECONDS:-600} \
        "$W/gpu_guard2.sh" "${STAGE4_HIP:-0,1}" "stage4-$label" -- "$W/gpu.sh" "$@"
}
